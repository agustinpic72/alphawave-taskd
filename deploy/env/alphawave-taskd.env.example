# AlphaWave TaskD VPS private beta environment template.
#
# Copy manually to /opt/alphawave-taskd/.env on the VPS and fill secrets there.
# Do not commit the real .env. Runtime behavior is edited in Settings; this file
# is for infrastructure, process defaults, paths, and secrets.

# Infrastructure / server
ALPHAWAVE_DEPLOYMENT_MODE=private
APP_HOST=127.0.0.1
APP_PORT=8711
APP_DEV_ENDPOINTS_ENABLED=false
APP_TIMEZONE=UTC
DATABASE_URL=sqlite:////opt/alphawave-taskd/data/alphawave-taskd.sqlite
LOG_FILE=/opt/alphawave-taskd/logs/alphawave-taskd.log

# Auth shell / private beta login
# Required in private/public mode. Public mode also requires secure cookies.
ALPHAWAVE_AUTH_ENABLED=true
ALPHAWAVE_AUTH_COOKIE_SECURE=true
ALPHAWAVE_AUTH_SESSION_TTL_HOURS=168
ALPHAWAVE_AUTH_COOKIE_NAME=alphawave_session
ALPHAWAVE_SECRET_ENCRYPTION_KEY=

# Telegram integration
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=
TELEGRAM_POLL_INTERVAL_SECONDS=3

# Reminders / briefing defaults. Settings UI can override runtime behavior.
REMINDERS_ENABLED=true
REMINDERS_POLL_INTERVAL_SECONDS=30
DAILY_BRIEFING_ENABLED=true
DAILY_BRIEFING_TIME=13:00
DAILY_BRIEFING_LATE_CUTOFF=19:00
DAILY_BRIEFING_TIMEZONE=UTC
DAILY_BRIEFING_SEND_ON_STARTUP=true

# Trello integration
TRELLO_ENABLED=false
TRELLO_API_KEY=
TRELLO_TOKEN=
TRELLO_MEMBER_ID=
TRELLO_SYNC_INTERVAL_MINUTES=15
TRELLO_WRITE_ENABLED=false
TRELLO_CONFIRMATION_TTL_HOURS=24

# OpenAI credentials and model are configured per user from Settings.

# Backups
BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=30
