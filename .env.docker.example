# Optional Docker Compose overrides. Copy to `.env.docker` and start with:
# docker compose --env-file .env.docker up --build
#
# The API remains internal to the Compose network. Only the web gateway is
# published on the host. Application integrations remain disabled in
# compose.yaml and this file intentionally contains no secret placeholders.

ALPHAWAVE_WEB_BIND=127.0.0.1
ALPHAWAVE_WEB_PORT=8711
ALPHAWAVE_IMAGE_TAG=local
ALPHAWAVE_DATA_VOLUME=alphawave_data
ALPHAWAVE_BACKUPS_VOLUME=alphawave_backups
ALPHAWAVE_VOLUMES_EXTERNAL=false
ALPHAWAVE_INSTANCE_LOCK_PATH=/app/data/alphawave-taskd.runtime.lock

# Keep local mode for a workstation. Private/public modes fail closed unless
# their backend security requirements are satisfied.
ALPHAWAVE_DEPLOYMENT_MODE=local

# Authentication is optional in local mode. Set true, start the stack, then run
# `docker compose exec api python /app/scripts/admin/create_owner.py`.
ALPHAWAVE_AUTH_ENABLED=false
ALPHAWAVE_AUTH_COOKIE_SECURE=false
ALPHAWAVE_AUTH_COOKIE_NAME=alphawave_session
ALPHAWAVE_AUTH_SESSION_TTL_HOURS=168
ALPHAWAVE_SECRET_ENCRYPTION_KEY=

# Local scheduling defaults.
APP_TIMEZONE=UTC
REMINDERS_ENABLED=true
REMINDERS_POLL_INTERVAL_SECONDS=30
DAILY_BRIEFING_ENABLED=true
DAILY_BRIEFING_TIME=13:00
DAILY_BRIEFING_LATE_CUTOFF=19:00
DAILY_BRIEFING_TIMEZONE=UTC
DAILY_BRIEFING_SEND_ON_STARTUP=true

# Backups stay in the dedicated named volume.
BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=30

# Integrations fail closed by default. Use prepare-docker-env.sh to copy only
# supported settings from an existing local .env without displaying values.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=
TELEGRAM_POLL_INTERVAL_SECONDS=3
TRELLO_ENABLED=false
TRELLO_API_KEY=
TRELLO_TOKEN=
TRELLO_MEMBER_ID=
TRELLO_BOARD_ALPHA_ID=
TRELLO_BOARD_BETA_ID=
TRELLO_SYNC_INTERVAL_MINUTES=15
TRELLO_WRITE_ENABLED=false
TRELLO_CONFIRMATION_TTL_HOURS=24
