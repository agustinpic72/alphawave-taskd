# Copy this file to `.env` for local development.
# Keep real `.env` files private. Do not commit tokens, API keys, chat IDs,
# SQLite databases, backups, diagnostics or support bundles.
#
# Most app behavior is configured at runtime in Settings: briefing, reminders,
# weekend mode, priority scoring, Trello board/list mappings and backups.
# `.env` is for infrastructure and sensitive values.

# local permits disabled auth and exposes developer documentation. private and
# public require auth and disable developer endpoints; public also requires
# secure cookies.
ALPHAWAVE_DEPLOYMENT_MODE=local
APP_HOST=127.0.0.1
APP_PORT=8711
APP_DEV_ENDPOINTS_ENABLED=false
APP_TIMEZONE=UTC
APP_DAILY_BRIEFING_TIME=13:00
APP_DAILY_BRIEFING_LATEST_TIME=19:00

DATABASE_URL=sqlite:///data/alphawave-taskd.sqlite
LOG_FILE=./logs/alphawave-taskd.log

ALPHAWAVE_AUTH_ENABLED=false
ALPHAWAVE_AUTH_COOKIE_SECURE=false
ALPHAWAVE_AUTH_SESSION_TTL_HOURS=168
ALPHAWAVE_AUTH_COOKIE_NAME=alphawave_session
ALPHAWAVE_SECRET_ENCRYPTION_KEY=

TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=
TELEGRAM_POLL_INTERVAL_SECONDS=3

REMINDERS_ENABLED=true
REMINDERS_POLL_INTERVAL_SECONDS=30

DAILY_BRIEFING_ENABLED=true
DAILY_BRIEFING_TIME=13:00
DAILY_BRIEFING_LATE_CUTOFF=19:00
DAILY_BRIEFING_TIMEZONE=UTC
DAILY_BRIEFING_SEND_ON_STARTUP=true
DAILY_BRIEFING_MAX_DEEP_WORK=3
DAILY_BRIEFING_MAX_QUICK_TASKS=5
DAILY_BRIEFING_MAX_REVIEWS=5
DAILY_BRIEFING_MAX_ATTENTION=5
DAILY_BRIEFING_MAX_INBOX=5
DAILY_BRIEFING_MAX_PERPETUALS=3

CHECKINS_ENABLED=true
IN_PROGRESS_STALE_DAYS=2
PERPETUAL_MAX_PER_DAY=3

TRELLO_ENABLED=false
TRELLO_API_KEY=
TRELLO_TOKEN=
TRELLO_MEMBER_ID=
TRELLO_BOARD_ALPHA_ID=
TRELLO_BOARD_BETA_ID=
TRELLO_SYNC_INTERVAL_MINUTES=15
TRELLO_WRITE_ENABLED=false
TRELLO_CONFIRMATION_TTL_HOURS=24

# OpenAI is configured per user from Settings. Only the installation-level
# Fernet key above belongs in this file.

BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=30
